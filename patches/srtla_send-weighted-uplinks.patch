+
+pub fn read_uplink_weights(path: &str) -> Result<HashMap<IpAddr, f64>> {
+    let text = std::fs::read_to_string(Path::new(path)).context("read uplink weights file")?;
+    parse_uplink_weights(&text)
+}
+
+fn parse_uplink_weights(text: &str) -> Result<HashMap<IpAddr, f64>> {
+    let mut weights = HashMap::new();
+
+    for (index, line) in text.lines().enumerate() {
+        let trimmed = line.trim();
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            continue;
+        }
+
+        let mut fields = trimmed.split_whitespace();
+        let ip_text = fields
+            .next()
+            .ok_or_else(|| anyhow!("missing IP on weight line {}", index + 1))?;
+        let weight_text = fields
+            .next()
+            .ok_or_else(|| anyhow!("missing weight on line {}", index + 1))?;
+        if fields.next().is_some() {
+            return Err(anyhow!("too many fields on weight line {}", index + 1));
+        }
+
+        let ip: IpAddr = ip_text
+            .parse()
+            .with_context(|| format!("invalid IP on weight line {}", index + 1))?;
+        let weight: f64 = weight_text
+            .parse()
+            .with_context(|| format!("invalid weight on line {}", index + 1))?;
+        if !weight.is_finite() || weight <= 0.0 || weight > 100.0 {
+            return Err(anyhow!(
+                "weight on line {} must be finite and in the range (0, 100]",
+                index + 1
+            ));
+        }
+        weights.insert(ip, weight);
+    }
+
+    Ok(weights)
+}
+
+#[cfg(test)]
+mod weight_tests {
+    use super::parse_uplink_weights;
+    use std::net::IpAddr;
+
+    #[test]
+    fn parses_weights_and_comments() {
+        let weights = parse_uplink_weights(
+            "# Mikhlink uplinks\n192.168.1.10 2.0\n192.168.1.11 0.01\n",
+        )
+        .unwrap();
+
+        assert_eq!(weights[&"192.168.1.10".parse::<IpAddr>().unwrap()], 2.0);
+        assert_eq!(weights[&"192.168.1.11".parse::<IpAddr>().unwrap()], 0.01);
+    }
+
+    #[test]
+    fn rejects_non_positive_or_non_finite_weights() {
+        assert!(parse_uplink_weights("192.168.1.10 0\n").is_err());
+        assert!(parse_uplink_weights("192.168.1.10 NaN\n").is_err());
+    }
+}
