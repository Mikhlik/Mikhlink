+async fn connect_moblink_relay(
+    relay: &MoblinkRelaySpec,
+    binder: &Arc<dyn UplinkBinder>,
+) -> Result<(SrtlaConnection, ConnIo)> {
+    use rand::RngCore;
+
+    let remote = SocketAddr::new(relay.remote_ip, relay.remote_port);
+    let sock = create_uplink_socket(relay.bind_ip)?;
+    binder.bind(&sock, relay.bind_ip)?;
+    sock.connect(&remote.into())?;
+    sock.set_nonblocking(true)?;
+    let socket = Arc::new(BatchUdpSocket::new(sock)?);
+
+    let conn_id = rand::rng().next_u64();
+    let label = format!(
+        "Moblink {} at {} via {}",
+        relay.name, remote, relay.bind_ip
+    );
+    let mut conn =
+        SrtlaConnection::new_registering(conn_id, label, relay.bind_ip, now_ms());
+    conn.uplink_id = relay.uplink_id();
+    conn.uplink_kind = "moblink".to_string();
+    conn.display_name = relay.name.clone();
+    let io = ConnIo {
+        socket,
+        binder: binder.clone(),
+        remote,
+    };
+    Ok((conn, io))
+}
