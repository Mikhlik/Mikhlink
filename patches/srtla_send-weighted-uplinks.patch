+pub fn read_uplink_weights(path: &str) -> Result<HashMap<String, f64>> {
+    let text = std::fs::read_to_string(Path::new(path)).context("read uplink weights file")?;
+    parse_uplink_weights(&text)
+}
+
+fn apply_uplink_weights(
+    connections: &mut [SrtlaConnection],
+    weights: &HashMap<String, f64>,
+) -> usize {
+    let mut changed = 0;
+    for connection in connections {
+        let weight = weights.get(&connection.uplink_id).copied().unwrap_or(1.0);
+        if (connection.scheduling_weight - weight).abs() <= f64::EPSILON {
+            continue;
+        }
+
+        connection.scheduling_weight = weight;
+        changed += 1;
+        info!(
+            "configured uplink weight: {} = {:.4}",
+            connection.uplink_id, weight
+        );
+    }
+    changed
+}
+
+fn parse_uplink_weights(text: &str) -> Result<HashMap<String, f64>> {
+    let mut weights = HashMap::new();
+
+    for (index, line) in text.lines().enumerate() {
+        let trimmed = line.trim();
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            continue;
+        }
+
+        let mut fields = trimmed.split_whitespace();
+        let id = fields
+            .next()
+            .ok_or_else(|| anyhow!("missing uplink id on weight line {}", index + 1))?;
+        let weight_text = fields
+            .next()
+            .ok_or_else(|| anyhow!("missing weight on line {}", index + 1))?;
+        if fields.next().is_some() {
+            return Err(anyhow!("too many fields on weight line {}", index + 1));
+        }
+
+        if id.len() > 256 {
+            return Err(anyhow!("uplink id is too long on weight line {}", index + 1));
+        }
+        let weight: f64 = weight_text
+            .parse()
+            .with_context(|| format!("invalid weight on line {}", index + 1))?;
+        if !weight.is_finite() || weight < 0.0 || weight > 100.0 {
+            return Err(anyhow!(
+                "weight on line {} must be finite and in the range [0, 100]",
+                index + 1
+            ));
+        }
+        weights.insert(id.to_string(), weight);
+    }
+
+    Ok(weights)
+}
