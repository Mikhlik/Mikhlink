+/// Reconcile the live set of remote Moblink phone relays without disturbing
+/// physical IP-bound connections. Returns the `conn_id`s of newly added links
+/// so an already-registered SRTLA group can send REG2 immediately.
+#[allow(clippy::too_many_arguments)]
+pub async fn apply_moblink_relay_changes(
+    connections: &mut SmallVec<SrtlaConnection, 4>,
+    conn_io: &mut ConnIoMap,
+    relays: &[MoblinkRelaySpec],
+    last_selected_idx: &mut Option<usize>,
+    seq_tracker: &mut SequenceTracker,
+    binder: &Arc<dyn UplinkBinder>,
+) -> SmallVec<u64, 4> {
+    let desired: HashMap<String, &MoblinkRelaySpec> = relays
+        .iter()
+        .map(|relay| (relay.uplink_id(), relay))
+        .collect();
+
+    let removed_conn_ids: Vec<u64> = connections
+        .iter()
+        .filter(|connection| connection.uplink_kind == "moblink")
+        .filter(|connection| {
+            let Some(relay) = desired.get(&connection.uplink_id) else {
+                return true;
+            };
+            connection.local_ip != relay.bind_ip
+                || conn_io
+                    .get(&connection.conn_id)
+                    .is_none_or(|io| io.remote != relay.remote_addr())
+        })
+        .map(|connection| connection.conn_id)
+        .collect();
+
+    if !removed_conn_ids.is_empty() {
+        let removed: HashSet<u64> = removed_conn_ids.iter().copied().collect();
+        connections.retain(|connection| !removed.contains(&connection.conn_id));
+        *last_selected_idx = None;
+        for conn_id in removed_conn_ids {
+            seq_tracker.remove_connection(conn_id);
+            conn_io.remove(&conn_id);
+        }
+        info!("removed stale Moblink relay connection(s)");
+    }
+
+    // Names are metadata: update them in place without forcing a UDP/SRTLA
+    // reconnect when the phone is renamed.
+    for connection in connections
+        .iter_mut()
+        .filter(|connection| connection.uplink_kind == "moblink")
+    {
+        if let Some(relay) = desired.get(&connection.uplink_id) {
+            connection.display_name = relay.name.clone();
+            connection.label = format!(
+                "Moblink {} at {} via {}",
+                relay.name,
+                relay.remote_addr(),
+                relay.bind_ip
+            );
+        }
+    }
+
+    let existing: HashSet<String> = connections
+        .iter()
+        .filter(|connection| connection.uplink_kind == "moblink")
+        .map(|connection| connection.uplink_id.clone())
+        .collect();
+    let mut added = SmallVec::new();
+    for relay in relays {
+        if existing.contains(&relay.uplink_id()) {
+            continue;
+        }
+        match connect_moblink_relay(relay, binder).await {
+            Ok((connection, io)) => {
+                info!("added uplink {}", connection.label);
+                added.push(connection.conn_id);
+                conn_io.insert(connection.conn_id, io);
+                connections.push(connection);
+            }
+            Err(error) => warn!(
+                "failed to add Moblink relay {} at {}: {}",
+                relay.name,
+                relay.remote_addr(),
+                error
+            ),
+        }
+    }
+    added
+}
