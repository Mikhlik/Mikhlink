index 0000000..bff82c8
--- /dev/null
+++ b/src/sender/moblink.rs
@@ -0,0 +1,143 @@
+//! Dynamic Moblink relay descriptors supplied by the OBS host integration.
+//!
+//! A relay phone is not a local network interface. The Moblink control plane
+//! asks the phone to open a UDP tunnel to the SRTLA receiver, then publishes
+//! the phone's LAN endpoint here. The sender binds a normal UDP socket to the
+//! PC address that accepted the WebSocket and connects that socket directly to
+//! the phone endpoint, matching Moblin's native SRTLA integration without a
+//! TUN device or platform driver.
+
+use std::collections::HashSet;
+use std::net::{IpAddr, SocketAddr};
+use std::path::Path;
+
+use anyhow::{Context, Result, anyhow};
+use serde::Deserialize;
+
+const MAX_RELAY_COUNT: usize = 32;
+const MAX_RELAY_ID_LEN: usize = 128;
+const MAX_RELAY_NAME_LEN: usize = 128;
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct MoblinkRelayFile {
+    version: u32,
+    #[serde(default)]
+    relays: Vec<MoblinkRelaySpec>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize)]
+pub struct MoblinkRelaySpec {
+    pub id: String,
+    pub name: String,
+    pub bind_ip: IpAddr,
+    pub remote_ip: IpAddr,
+    pub remote_port: u16,
+}
+
+impl MoblinkRelaySpec {
+    pub fn uplink_id(&self) -> String {
+        format!("moblink:{}", self.id)
+    }
+
+    pub fn remote_addr(&self) -> SocketAddr {
+        SocketAddr::new(self.remote_ip, self.remote_port)
+    }
+
+    fn validate_and_normalize(mut self) -> Result<Self> {
+        self.id = self.id.trim().to_string();
+        self.name = self.name.trim().to_string();
+        if self.id.is_empty()
+            || self.id.len() > MAX_RELAY_ID_LEN
+            || self.id.chars().any(char::is_whitespace)
+        {
+            return Err(anyhow!(
+                "Moblink relay id is empty, too long, or contains whitespace"
+            ));
+        }
+        if self.name.is_empty() || self.name.len() > MAX_RELAY_NAME_LEN {
+            return Err(anyhow!("Moblink relay name is empty or too long"));
+        }
+        if self.remote_port == 0 {
+            return Err(anyhow!("Moblink relay UDP port must be non-zero"));
+        }
+        if self.bind_ip.is_ipv4() != self.remote_ip.is_ipv4() {
+            return Err(anyhow!("Moblink bind and remote IP families differ"));
+        }
+        if self.bind_ip.is_unspecified() || self.remote_ip.is_unspecified() {
+            return Err(anyhow!("Moblink relay addresses must be concrete"));
+        }
+        Ok(self)
+    }
+}
+
+pub fn read_moblink_relays(path: &str) -> Result<Vec<MoblinkRelaySpec>> {
+    let path = Path::new(path);
+    if !path.exists() {
+        return Ok(Vec::new());
+    }
+    let text = std::fs::read_to_string(path).context("read Moblink relay file")?;
+    parse_moblink_relays(&text)
+}
+
+fn parse_moblink_relays(text: &str) -> Result<Vec<MoblinkRelaySpec>> {
+    if text.trim().is_empty() {
+        return Ok(Vec::new());
+    }
+    let file: MoblinkRelayFile =
+        serde_json::from_str(text).context("parse Moblink relay file")?;
+    if file.version != 1 {
+        return Err(anyhow!(
+            "unsupported Moblink relay file version {}",
+            file.version
+        ));
+    }
+    if file.relays.len() > MAX_RELAY_COUNT {
+        return Err(anyhow!("too many Moblink relays (maximum {MAX_RELAY_COUNT})"));
+    }
+
+    let mut ids = HashSet::new();
+    let mut relays = Vec::with_capacity(file.relays.len());
+    for relay in file.relays {
+        let relay = relay.validate_and_normalize()?;
+        if !ids.insert(relay.id.clone()) {
+            return Err(anyhow!("duplicate Moblink relay id {}", relay.id));
+        }
+        relays.push(relay);
+    }
