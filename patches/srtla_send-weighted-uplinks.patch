+        )
+        .unwrap();
+        assert_eq!(relays.len(), 1);
+        assert_eq!(relays[0].id, "1234");
+        assert_eq!(relays[0].name, "Phone");
+        assert_eq!(relays[0].uplink_id(), "moblink:1234");
+        assert_eq!(relays[0].remote_addr(), "192.168.1.9:4567".parse().unwrap());
+    }
+
+    #[test]
+    fn rejects_duplicates_and_invalid_endpoints() {
+        assert!(
+            parse_moblink_relays(
+                r#"{"version":1,"relays":[{"id":"same","name":"A","bind_ip":"192.168.1.2","remote_ip":"192.168.1.9","remote_port":1},{"id":"same","name":"B","bind_ip":"192.168.1.2","remote_ip":"192.168.1.10","remote_port":2}]}"#,
+            )
+            .is_err()
+        );
+        assert!(
+            parse_moblink_relays(
+                r#"{"version":1,"relays":[{"id":"bad id","name":"A","bind_ip":"192.168.1.2","remote_ip":"192.168.1.9","remote_port":0}]}"#,
+            )
+            .is_err()
+        );
+        assert!(parse_moblink_relays(r#"{"version":2,"relays":[]}"#).is_err());
+    }
+}
